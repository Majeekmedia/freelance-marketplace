APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# APP_URL determines every absolute URL the application generates: password
# reset links, email links, signed URLs and asset URLs in queued mail.
# A wrong value produces links to the wrong host — and because reset links are
# emailed from a queued job (no browser request to infer from), there is no
# fallback. Set this to the real origin before deploying.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Outgoing email
# ---------------------------------------------------------------------------
# Local development writes mail to storage/logs/laravel.log (MAIL_MAILER=log).
# In production use authenticated SMTP over TLS:
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.provider.com
#   MAIL_PORT=587
#   MAIL_SCHEME=tls          # tls = STARTTLS on 587 | smtp = implicit TLS on 465
#   MAIL_USERNAME=your-username
#   MAIL_PASSWORD=your-password
#   MAIL_FROM_ADDRESS=hello@your-domain.com
#   MAIL_FROM_NAME="${APP_NAME}"
#
# Verify before going live:
#   php artisan mail:test you@example.com
#
# These credentials live ONLY here. They are never stored in the database and
# are never editable from the admin dashboard: a compromised admin account that
# could repoint SMTP could read every password-reset email.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
